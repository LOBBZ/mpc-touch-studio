{
  "name": "mpc-touch-studio",
  "productName": "MPC Touch Studio",
  "version": "2.2.1",
  "description": "Touch sampler, step sequencer en multitrack-recorder met MIDI naar FL Studio, Ableton en Logic.",
  "main": "electron/main.js",
  "author": "Ryan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "npx http-server www -p 8080 -c-1",
    "electron": "electron .",
    "build:win": "electron-builder --win nsis portable zip --x64",
    "build:mac": "electron-builder --mac zip",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "build": {
    "appId": "com.mpctouchstudio.app",
    "productName": "MPC Touch Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json",
      "!www/sw.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "www/icons/icon-512.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "www/icons/icon-1024.png",
      "category": "public.app-category.music",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MPC Touch Studio gebruikt de microfoon om zang en instrumenten op te nemen op een audiospoor."
      }
    },
    "artifactName": "MPC-Touch-Studio-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MPC Touch Studio",
      "deleteAppDataOnUninstall": false,
      "artifactName": "MPC-Touch-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MPC-Touch-Studio-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "bridge-dist",
        "to": "bridge",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}